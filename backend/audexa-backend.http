@audexa_backend_HostAddress = http://localhost:5081

GET {{audexa_backend_HostAddress}}/weatherforecast/
Accept: application/json

###


### Scenarios

GET http://localhost:5081/api/scenarios
Accept: application/json

###

GET http://localhost:5081/api/scenarios/{scenarioId}
Accept: application/json

###

POST http://localhost:5081/api/scenarios
Content-Type: application/json

{
  "name": "Экскурсия по музею",
  "description": "Основной сценарий экскурсии",
  "status": "inactive",
  "playMode": "sequential",
  "repeat": "once",
  "stopPrevious": true,
  "steps": []
}

###

PUT http://localhost:5081/api/scenarios/{scenarioId}
Content-Type: application/json

{
  "name": "Экскурсия по музею",
  "description": "Основной сценарий экскурсии",
  "status": "active",
  "playMode": "sequential",
  "repeat": "once",
  "stopPrevious": true,
  "steps": [
    {
      "id": null,
      "roomId": "00000000-0000-0000-0000-000000000000",
      "audioFileId": "00000000-0000-0000-0000-000000000000",
      "volume": 80,
      "delayMs": 0
    }
  ]
}

###

POST http://localhost:5081/api/scenarios/{scenarioId}/validate
Accept: application/json

###

DELETE http://localhost:5081/api/scenarios/{scenarioId}
